<script type="text/javascript">
    //<![CDATA[

    function calculateSliderWidth() {
        return $$('.main-slider').first().getWidth();
    }

    Event.observe(window, "resize", function () {
        $$('#main_slider img').each(function(elmt) {
            elmt.setStyle({ 'max-width' : calculateSliderWidth() + 'px' });
            main_slider.slideWidth = calculateSliderWidth();
            elmt.setStyle({ 'width' : calculateSliderWidth() + 'px' });
        });
        $$('#main_slider .slide-container').each(function(elmt) {
            elmt.setStyle({ 'max-width' : calculateSliderWidth() + 'px' });
            elmt.setStyle({ 'width' : calculateSliderWidth() + 'px' });
        });
    });

    $$('#main_slider img').each(function(elmt) {
        elmt.setStyle({ 'max-width' : calculateSliderWidth() + 'px' });
        elmt.setStyle({ 'width' : calculateSliderWidth() + 'px' });
    });

    $$('#main_slider .slide-container').each(function(elmt) {
        elmt.setStyle({ 'max-width' : calculateSliderWidth() + 'px' });
        elmt.setStyle({ 'width' : calculateSliderWidth() + 'px' });
    });

    var main_slider = new protoShow('main_slider', {
        captions			: true,
        controls			: true,
        progressTimer       : false,
        transitionType		: "slide"
    });

    main_slider.slideWidth = calculateSliderWidth();
    //]]>
</script>
